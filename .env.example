# ── API Keys ─────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DISCORD_BOT_TOKEN=
TAVILY_API_KEY=

# ── TTS (Text-to-Speech) ─────────────────────────────────────────────────────
# Provider: "supertonic" (local ONNX, expression tags), "edge" (cloud), or "kokoro" (local fallback)
TTS_PROVIDER=supertonic

# Voice name for the chosen provider:
#   Supertonic: F1-F5 (female), M1-M5 (male)
#   Edge:       en-US-AvaNeural, en-US-JennyNeural, en-GB-SoniaNeural, etc.
#   Kokoro:     af_bella, af_sky, af_nicole, af_sarah
TTS_VOICE=F1
